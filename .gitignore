data/
datasets/
*.csv
*.tsv
*.jsonl
*.parquet
*.h5
*.hdf5
*.npy
*.npz

# Large Model weights, checkpoints, and serialized assets
models/
checkpoints/
weights/
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.ckpt
*.onnx
*.pb
*.tflite

# Experiment tracking, logging, and visualization dashboards
logs/
lightning_logs/
tensorboard/
.wandb/
wandb/
mlruns/
